# Copy to e2e/.env to override the defaults (e2e/.env is git-ignored).

# The web app (thesuperappweb `yarn dev`). Must be an origin the server's CORS_ORIGIN allows.
LIVE_BASE_URL=http://localhost:3039
# thesuperappserver (`yarn start:dev`); only checked for reachability.
LIVE_API_URL=http://localhost:3000

# Postgres of thesuperappserver's docker-compose.yml; the tests run psql in it via `docker exec`.
LIVE_DB_CONTAINER=thesuperappserver-postgres-1
LIVE_DB_USER=superapp
LIVE_DB_NAME=thesuperapp

# Port of the local runner the admin dashboard talks to. If changed, also set
# NEXT_PUBLIC_E2E_RUNNER_URL in the admin's .env.local.
E2E_RUNNER_PORT=4140

# Terminal runs only (the dashboard sets these per run):
# E2E_HEADLESS=1        run without showing the browser
# E2E_SLOW_MO=500       wait 500 ms before each browser action
# E2E_BROWSER=chromium  Playwright's Chromium instead of the installed Google Chrome
